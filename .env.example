# InterviewOS AI - configuration
# Copy to .env and fill in what you need. Every value is optional for local
# development: without keys the app runs fully offline (deterministic extractive
# answers, hashing embeddings, browser speech recognition).
# NEVER commit a real .env.

# ---------------------------------------------------------------- environment
ENVIRONMENT=development            # development | production (production enforces safe settings)

# ---------------------------------------------------------------- persistence
# PostgreSQL in production; SQLite file for zero-dependency local runs.
DATABASE_URL=sqlite:///./interviewos.db
# DATABASE_URL=postgresql://interviewos:interviewos-dev@localhost:5432/interviewos
POSTGRES_PASSWORD=                 # used by docker-compose's postgres service

# Qdrant: an http(s) URL for a server, a filesystem path for embedded local mode, or :memory:
QDRANT_URL=./qdrant_data
QDRANT_API_KEY=

# Redis (optional): shared rate limits across API replicas
REDIS_URL=

# ---------------------------------------------------------------- answer generation (LLM)
# auto -> uses Anthropic when LLM_API_KEY is set, otherwise the offline composer
LLM_PROVIDER=auto
LLM_API_KEY=                       # Anthropic API key (console.anthropic.com)
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low                     # low keeps first-token latency down for live answers
LLM_TIMEOUT_S=30
LLM_JUDGE_ENABLED=false            # optional second LLM call to refine practice-answer scoring

# ---------------------------------------------------------------- embeddings
EMBEDDING_PROVIDER=hash            # hash (offline, default) | openai (any OpenAI-compatible /v1/embeddings API)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIM=384                  # changing this recreates the Qdrant collections - re-index afterwards

# ---------------------------------------------------------------- speech-to-text
STT_PROVIDER=browser               # browser (Web Speech API, no key) | deepgram (server-side streaming)
STT_API_KEY=                       # Deepgram API key when STT_PROVIDER=deepgram
STT_MODEL=nova-3
TURN_ENDPOINT_MS=1200              # silence after speech before a question is considered complete
TURN_MIN_WORDS=2

# ---------------------------------------------------------------- security
AUTH_SECRET=                       # REQUIRED in production: 32+ random chars (python -c "import secrets;print(secrets.token_urlsafe(48))")
ACCESS_TOKEN_TTL_MINUTES=720
COOKIE_SECURE=false                # true in production (HTTPS)
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_MB=8

# ---------------------------------------------------------------- privacy
STORE_RAW_AUDIO=false              # server-wide permission; users must ALSO opt in under Settings
RECORDINGS_DIR=./recordings

# ---------------------------------------------------------------- frontend
BACKEND_URL=http://localhost:8000  # where Next.js proxies /api/* (build-time for the Docker image)
NEXT_PUBLIC_WS_URL=                # empty = derive from the page origin (dev: ws://localhost:8000)
